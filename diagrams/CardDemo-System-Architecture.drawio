<mxfile host="drawio" type="device"><diagram id="CardDemo-System-Architecture" name="CardDemo System Architecture"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="CardDemo system architecture &amp;ndash; online (CICS), data stores and batch" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1100" height="40" as="geometry"/></mxCell><mxCell id="c2" value="3270 terminal&lt;br&gt;regular user" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="110" width="30" height="55" as="geometry"/></mxCell><mxCell id="c3" value="3270 terminal&lt;br&gt;admin user" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="290" width="30" height="55" as="geometry"/></mxCell><mxCell id="c4" value="CICS region &amp;ndash; CSD group CARDDEMO (app/csd/CARDDEMO.CSD), BMS maps app/bms" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;fillColor=#fafafa;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="190" y="70" width="650" height="750" as="geometry"/></mxCell><mxCell id="c5" value="Base online application (app/cbl)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;arcSize=6;fillColor=none;strokeColor=#d79b00;dashed=1;fontStyle=2;align=right;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="210" y="100" width="620" height="420" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Sign-on&lt;/b&gt; CC00 / COSGN00C&lt;br&gt;validates USRSEC, routes by user type" style="rounded=1;whiteSpace=