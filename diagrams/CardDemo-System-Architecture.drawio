c12" value="&lt;b&gt;Bill payment&lt;/b&gt; CB00 COBIL00C" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="220" y="408" width="280" height="30" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Transaction reports&lt;/b&gt; CR00 CORPT00C&lt;br&gt;writes TRANREPT JCL to TDQ JOBS" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="220" y="456" width="280" height="44" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;User admin&lt;/b&gt; CU00-CU03 / COUSR00C-03C&lt;br&gt;list, add, update, delete users" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="540" y="250" width="280" height="44" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Transaction type management&lt;/b&gt; (app-transaction-type-db2): CTLI COTRTLIC list/update/delete, CTTU COTRTUPC add/edit" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="220" y="560" width="600" height="50" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Pending authorizations&lt;/b&gt; (app-authorization-ims-db2-mq): CP00 COPAUA0C MQ-triggered authorizer (reads CCXREF, ACCTDAT, CUSTDAT);&lt;br&gt;CPVS COPAUS0C summary, CPVD COPAUS1C details; COPAUS2C (LINK) inserts / updates AUTHFRDS on fraud flag" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="220" y="630" width="600" height="70" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;MQ inquiry&lt;/b&gt; (app-vsam-mq): CDRD CODATE01 system date, CDRA COACCT01 account details from ACCTDAT" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="220" y="720" width="600" height="50" as="geometry"/></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.3;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.75;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="317"/><mxPoint x="150" y="153"/></Array></mxGeometry></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="680" y="142"/></Array></mxGeometry></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCel