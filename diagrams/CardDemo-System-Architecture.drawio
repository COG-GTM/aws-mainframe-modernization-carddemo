strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="920" y="495" width="340" height="75" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;IBM MQ queues&lt;/b&gt;&lt;br&gt;AWS.M2.CARDDEMO.PAUTH.REQUEST / .REPLY&lt;br&gt;CARDDEMO.REQUEST.QUEUE / .RESPONSE.QUEUE" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="920" y="600" width="340" height="70" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;CICS TDQ JOBS&lt;/b&gt; &amp;gt; internal reader (JES)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="920" y="700" width="340" height="32" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Sequential / GDG datasets&lt;/b&gt;&lt;br&gt;DALYTRAN.PS, DALYREJS, SYSTRAN, TRANSACT.BKUP,&lt;br&gt;TRANSACT.COMBINED / .DALY, TRANREPT,&lt;br&gt;STATEMNT.PS / .HTML, EXPORT.DATA, *.IMPORT&lt;br&gt;sample data: app/data/ASCII, app/data/EBCDIC" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=8;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="920" y="760" width="340" height="120" as="geometry"/></mxCell><mxCell id="e30" value="CICS file control" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;exitX=1;exitY=0.20238095238095238;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.375;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="845" y="585"/><mxPoint x="845" y="420"/></Array></mxGeometry></mxCell><mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;labelBackgroundColor=#ffffff;exitX=1;exitY=0.14285714285714285;entryX=0;entryY=0.75;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="858" y="640"/><mxPoint x="858" y="450"/></Array></mxGeometry></mxCell><mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.49333333333333335;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="871" y="665"/><mxPoint x="871" y="532"/></Array></mxGeometry></mxCell><mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;exitX=1;exitY=0.8571428571428571;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c27"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="884" y="690"/><mxPoint x="884" y="635"/></Array></mxGeometry></mxCell><mxCell id="e35" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.7857142857142857;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c27"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="897" y="745"/><mxPoint x="897" y="655"/></Array></mxGeometry></mxCell><mxCell id="e36" value="WRITEQ TD" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c28"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="205" y="478"/><mxPoint x="205" y="795"/><mxPoint x="910" y="795"/><mxPoint x="910" y="716"/></Array></mxGeometry></mxCell><mxCell id="c37" value="&lt;b&gt;Legend&lt;/b&gt;: orange = base application, blue = optional module, green = VSAM, grey = datasets / queues, purple = batch.&lt;br&gt;Arrows show data access direction; batch jobs close / open CICS files with CEMT (CLOSEFIL / OPENFIL) around file updates." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;arcSize=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="190" y="840" width="650" height="50" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Operations&lt;/b&gt;: Control-M, CA-7 or manual job submission" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1340" y="20" width="420" height="30" as="geometry"/></mxCell><mxCell id="c39" value="Batch &amp;ndash; JCL (app/jcl) and COBOL (app/cbl)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;arcSize=3;fillColor=#fafafa;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1320" y="70" width="460" height="510" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Schedulers (app/scheduler)&lt;/b&gt;: CardDemo.controlm (Control-M folders: daily transaction backup, weekly disclosure groups and Db2 tran types, monthly interest) and CardDemo.ca7 (CA-7 jobs and triggers)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1340" y="100" width="420" height="70" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;Core cycle&lt;/b&gt;&lt;br&gt;CLOSEFIL - close CICS files (SDSF / CEMT)&lt;br&gt;POSTTRAN - CBTRN02C posts DALYTRAN, rejects to DALYREJS&lt;br&gt;INTCALC - CBACT04C interest to SYSTRAN&lt;br&gt;TRANBKP - IDCAMS backup of TRANSACT&lt;br&gt;COMBTRAN - SORT + IDCAMS reload of TRANSACT&lt;br&gt;CREASTMT - CBSTM03A / CBSTM03B statements (PS + HTML)&lt;br&gt;TRANIDX - rebuild TRANSACT AIX; OPENFIL - reopen files" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1340" y="185" width="420" height="180" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;Optional module jobs&lt;/b&gt;&lt;br&gt;CREADB21 - create / load Db2 tables&lt;br&gt;MNTTRDB2 - COBTUPDT add / update / delete tran types&lt;br&gt;TRANEXTR - DSNTIAUL unload Db2 to TRANTYPE / TRANCATG&lt;br&gt;CBPAUP0J - CBPAUP0C purge expired pending auths (IMS BMP)&lt;br&gt;LOADPADB / UNLDPADB / UNLDGSAM - IMS load / unload" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1340" y="395" width="420" height="170" as="geometry"/></mxCell><mxCell id="e43" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c38" target="c40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCe