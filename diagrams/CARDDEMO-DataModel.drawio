><mxCell id="e91" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;strokeColor=#333333;" edge="1" parent="1" source="c65" target="c75"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e92" value="" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c34" target="c68"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="785" y="625"/><mxPoint x="1200" y="625"/></Array></mxGeometry></mxCell><mxCell id="e93" value="ACCT-ID" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="c22" target="c73"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="605" y="795"/><mxPoint x="1215" y="795"/></Array></mxGeometry></mxCell><mxCell id="c94" value='&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;&amp;bull; Every file is a VSAM KSDS loaded by IDCAMS from the AWS.M2.CARDDEMO.*.PS sample data (README "Initialize the Environment").&lt;br&gt;&amp;bull; Keys follow the IDCAMS KEYS(...) in app/jcl: AIX paths CARDAIX, CXACAIX and TRANSACT.VSAM.AIX.PATH give access by account / processed timestamp.&lt;br&gt;&amp;bull; ACCT-GROUP-ID selects the DISCLOSURE GROUP interest rate for each type/category (INTCALC / CBACT04C).&lt;br&gt;&amp;bull; CUSTOMER, ACCOUNT and CARD are only linked through CARD XREF (and CARD-ACCT-ID); there is no customer key on ACCOUNT.&lt;br&gt;&amp;bull; USER SECURITY drives sign-on (COSGN00C) and admin user maintenance (COUSR00C-03C); SEC-USR-TYPE A = admin, U = user.&lt;br&gt;&amp;bull; Db2 and IMS stores of the optional modules are on the next pages.' style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="760" height="130" as="geometry"/></mxCell><mxCell id="c95" value='&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;span style="background:#dae8fc"&gt;&amp;nbsp;master&amp;nbsp;&lt;/span&gt; &lt;span style="background:#d5e8d4"&gt;&amp;nbsp;cross-reference&amp;nbsp;&lt;/span&gt; &lt;span style="background:#ffe6cc"&gt;&amp;nbsp;transactions&amp;nbsp;&lt;/span&gt; &lt;span style="background:#e1d5e7"&gt;&amp;nbsp;reference / balances&amp;nbsp;&lt;/span&gt; &lt;span style="background:#f5f5f5"&gt;&amp;nbsp;input / security&amp;nbsp;&lt;/span&gt;&lt;br&gt;PK = key field, FK = logical reference (VSAM has no enforced FKs)' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=11;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1240" y="820" width="370" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="Db2-Data-Model-(optional-modules)" name="Db2 Data Model (optional modules)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="CardDemo Db2 tables - schema CARDDEMO (optional modules)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="40" as="geometry"/></mxCell><mxCell id="c2" value='&lt;b&gt;TRANSACTION_TYPE&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;app-transaction-type-db2/ddl/TRNTYPE.ddl &amp;middot; index XTRAN_TYPE&lt;/font&gt;' style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" p