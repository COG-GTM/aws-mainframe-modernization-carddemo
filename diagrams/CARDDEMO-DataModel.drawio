aint=eastwest;html=0;fontFamily=Courier New;fontSize=11;fillColor=#ffffff;" vertex="1" parent="c10"><mxGeometry x="0" y="464" width="400" height="20" as="geometry"/></mxCell><mxCell id="c33" value="AUTH_FRAUD  CHAR(1)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=0;fontFamily=Courier New;fontSize=11;fillColor=#ffffff;" vertex="1" parent="c10"><mxGeometry x="0" y="484" width="400" height="20" as="geometry"/></mxCell><mxCell id="c34" value="FRAUD_RPT_DATE  DATE" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=0;fontFamily=Courier New;fontSize=11;fillColor=#ffffff;" vertex="1" parent="c10"><mxGeometry x="0" y="504" width="400" height="20" as="geometry"/></mxCell><mxCell id="c35" value="ACCT_ID  DECIMAL(11)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=0;fontFamily=Courier New;fontSize=11;fillColor=#ffffff;" vertex="1" parent="c10"><mxGeometry x="0" y="524" width="400" height="20" as="geometry"/></mxCell><mxCell id="c36" value="CUST_ID  DECIMAL(9)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=0;fontFamily=Courier New;fontSize=11;fillColor=#ffffff;" vertex="1" parent="c10"><mxGeometry x="0" y="544" width="400" height="20" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Who uses these tables&lt;/b&gt;&lt;br&gt;&amp;bull; Transaction Type Mgmt module: COTRTLIC (CTLI list/update/delete, cursors), COTRTUPC (CTTU add/edit), batch COBTUPDT (MNTTRDB2); CREADB21 creates and loads; TRANEXTR (DSNTIAUL) unloads both tables to the TRANTYPE / TRANCATG files that feed the VSAM KSDS.&lt;br&gt;&amp;bull; Authorization module: COPAUS2C inserts / updates AUTHFRDS when an authorization is marked or unmarked as fraud from the Pending Authorization Details screen (CPVD).&lt;br&gt;&amp;bull; AUTHFRDS ACCT_ID / CUST_ID are logical links to the VSAM ACCOUNT and CUSTOMER records." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="420" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="IMS-Data-Model-(optional-module)" name="IMS Data Model (optional module)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Pending Authorization IMS databases (app-authorization-ims-db2-mq/ims)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="40" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;DBPAUTP0&lt;/b&gt; &amp;middot; HIDAM / VSAM &amp;middot; DD DDPAUTP0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="760" height="30" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b&gt;PAUTSUM0 - Pending Auth Summary (root, 100 B)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;key ACCNTID = PA-ACCT-ID (packed) &amp;middot; layout CIPAUSMY&lt;/font&gt;' style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent