s="points"><mxPoint x="230" y="450"/></Array></mxGeometry></mxCell><mxCell id="c39" value='&lt;b&gt;PAUTINDX (DBPAUTX0)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;primary INDEX / VSAM &amp;middot; DD DDPAUTX0&lt;/font&gt;' style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="110" width="300" height="64" as="geometry"/></mxCell><mxCell id="c40" value="KEY INDXSEQ  packed 6 B" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=0;fontFamily=Courier New;fontSize=11;fillColor=#ffffff;" vertex="1" parent="c39"><mxGeometry x="0" y="44" width="300" height="20" as="geometry"/></mxCell><mxCell id="e41" value="LCHILD index pointer" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=block;fontSize=10;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="c39" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c42" value="&lt;b&gt;Access&lt;/b&gt;&lt;br&gt;&amp;bull; COPAUA0C (CP00, MQ-triggered): GU summary, REPL or ISRT summary, ISRT detail for each authorization request.&lt;br&gt;&amp;bull; COPAUS0C / COPAUS1C (CPVS / CPVD screens): read summary + details, REPL detail when fraud is flagged (and LINK COPAUS2C for AUTHFRDS).&lt;br&gt;&amp;bull; CBPAUP0C (batch CBPAUP0J): GN / GNP walk, DLET expired details and empty summaries, CHKP.&lt;br&gt;&amp;bull; PSBs: PSBPAUTB, PSBPAUTL, PAUTBUNL, DLIGSAMP; load / unload via LOADPADB, UNLDPADB, UNLDGSAM." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="200" width="360" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
