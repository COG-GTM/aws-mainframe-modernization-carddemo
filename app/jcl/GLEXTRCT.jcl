//GLEXTRCT JOB 'LEDGER SUMMARY',CLASS=A,MSGCLASS=0,
//  NOTIFY=&SYSUID
//* Extract and reconcile posted ledger activity.
//STEP05   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DELETE AWS.M2.CARDDEMO.GLSUMM.EXTRACT
  DELETE AWS.M2.CARDDEMO.GLSUMM.OUTBOUND
  IF MAXCC LE 08 THEN SET MAXCC = 0
/*
//STEP10   EXEC PGM=IDCAMS
//TRANIN   DD DISP=SHR,DSN=AWS.M2.CARDDEMO.TRANSACT.VSAM.KSDS
//TRANOUT  DD DSN=&&TRANFILE,
//            DISP=(NEW,PASS),
//            DCB=(RECFM=FB,LRECL=350,BLKSIZE=0),
//            SPACE=(CYL,(1,1),RLSE)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  REPRO INFILE(TRANIN) OUTFILE(TRANOUT)
/*
//STEP15   EXEC PGM=IDCAMS
//XREFIN   DD DISP=SHR,DSN=AWS.M2.CARDDEMO.CARDXREF.VSAM.KSDS
//XREFOUT  DD DSN=&&XREFFILE,
//            DISP=(NEW,PASS),
//            DCB=(RECFM=FB,LRECL=50,BLKSIZE=0),
//            SPACE=(CYL,(1,1),RLSE)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  REPRO INFILE(XREFIN) OUTFILE(XREFOUT)
/*
//STEP20   EXEC PGM=IDCAMS
//BALIN    DD DISP=SHR,DSN=AWS.M2.CARDDEMO.TCATBALF.VSAM.KSDS
//BALOUT   DD DSN=&&TCATBALF,
//            DISP=(NEW,PASS),
//            DCB=(RECFM=FB,LRECL=50,BLKSIZE=0),
//            SPACE=(CYL,(1,1),RLSE)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  REPRO INFILE(BALIN) OUTFILE(BALOUT)
/*
//STEP30   EXEC PGM=CBGLX01C
//STEPLIB  DD DISP=SHR,
//            DSN=AWS.M2.CARDDEMO.LOADLIB
//SYSOUT   DD SYSOUT=*
//* Scheduler substitutes the run date on the control card.
//GLPARM   DD *
2026-10-12 CARDDEMO
/*
//TRANFILE DD DISP=(OLD,DELETE,DELETE),DSN=&&TRANFILE
//XREFFILE DD DISP=(OLD,DELETE,DELETE),DSN=&&XREFFILE
//TCATBALF DD DISP=(OLD,DELETE,DELETE),DSN=&&TCATBALF
//SORTWK01 DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SORTWK02 DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SORTWK03 DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//GLSUMOUT DD DISP=(NEW,CATLG,DELETE),
//            DSN=AWS.M2.CARDDEMO.GLSUMM.EXTRACT,
//            DCB=(RECFM=FB,LRECL=150,BLKSIZE=0),
//            SPACE=(CYL,(1,1),RLSE)
//GLRECRPT DD SYSOUT=*
//STEP40   EXEC PGM=IEBGENER,COND=(4,LT,STEP30)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DISP=SHR,DSN=AWS.M2.CARDDEMO.GLSUMM.EXTRACT
//SYSUT2   DD DISP=(NEW,CATLG,DELETE),
//            DSN=AWS.M2.CARDDEMO.GLSUMM.OUTBOUND,
//            DCB=(RECFM=FB,LRECL=150,BLKSIZE=0),
//            SPACE=(CYL,(1,1),RLSE)
