# CVACT01Y RecordLayout[ACCOUNT-RECORD, length=300]
01 ACCOUNT-RECORD @0 len=300
  05 ACCT-ID @0 len=11 PIC 9(11)
  05 ACCT-ACTIVE-STATUS @11 len=1 PIC X(01)
  05 ACCT-CURR-BAL @12 len=12 PIC S9(10)V99
  05 ACCT-CREDIT-LIMIT @24 len=12 PIC S9(10)V99
  05 ACCT-CASH-CREDIT-LIMIT @36 len=12 PIC S9(10)V99
  05 ACCT-OPEN-DATE @48 len=10 PIC X(10)
  05 ACCT-EXPIRAION-DATE @58 len=10 PIC X(10)
  05 ACCT-REISSUE-DATE @68 len=10 PIC X(10)
  05 ACCT-CURR-CYC-CREDIT @78 len=12 PIC S9(10)V99
  05 ACCT-CURR-CYC-DEBIT @90 len=12 PIC S9(10)V99
  05 ACCT-ADDR-ZIP @102 len=10 PIC X(10)
  05 ACCT-GROUP-ID @112 len=10 PIC X(10)
  05 FILLER @122 len=178 PIC X(178)
# CVACT02Y RecordLayout[CARD-RECORD, length=150]
01 CARD-RECORD @0 len=150
  05 CARD-NUM @0 len=16 PIC X(16)
  05 CARD-ACCT-ID @16 len=11 PIC 9(11)
  05 CARD-CVV-CD @27 len=3 PIC 9(03)
  05 CARD-EMBOSSED-NAME @30 len=50 PIC X(50)
  05 CARD-EXPIRAION-DATE @80 len=10 PIC X(10)
  05 CARD-ACTIVE-STATUS @90 len=1 PIC X(01)
  05 FILLER @91 len=59 PIC X(59)
# CVACT03Y RecordLayout[CARD-XREF-RECORD, length=50]
01 CARD-XREF-RECORD @0 len=50
  05 XREF-CARD-NUM @0 len=16 PIC X(16)
  05 XREF-CUST-ID @16 len=9 PIC 9(09)
  05 XREF-ACCT-ID @25 len=11 PIC 9(11)
  05 FILLER @36 len=14 PIC X(14)
# CVCUS01Y RecordLayout[CUSTOMER-RECORD, length=500]
01 CUSTOMER-RECORD @0 len=500
  05 CUST-ID @0 len=9 PIC 9(09)
  05 CUST-FIRST-NAME @9 len=25 PIC X(25)
  05 CUST-MIDDLE-NAME @34 len=25 PIC X(25)
  05 CUST-LAST-NAME @59 len=25 PIC X(25)
  05 CUST-ADDR-LINE-1 @84 len=50 PIC X(50)
  05 CUST-ADDR-LINE-2 @134 len=50 PIC X(50)
  05 CUST-ADDR-LINE-3 @184 len=50 PIC X(50)
  05 CUST-ADDR-STATE-CD @234 len=2 PIC X(02)
  05 CUST-ADDR-COUNTRY-CD @236 len=3 PIC X(03)
  05 CUST-ADDR-ZIP @239 len=10 PIC X(10)
  05 CUST-PHONE-NUM-1 @249 len=15 PIC X(15)
  05 CUST-PHONE-NUM-2 @264 len=15 PIC X(15)
  05 CUST-SSN @279 len=9 PIC 9(09)
  05 CUST-GOVT-ISSUED-ID @288 len=20 PIC X(20)
  05 CUST-DOB-YYYY-MM-DD @308 len=10 PIC X(10)
  05 CUST-EFT-ACCOUNT-ID @318 len=10 PIC X(10)
  05 CUST-PRI-CARD-HOLDER-IND @328 len=1 PIC X(01)
  05 CUST-FICO-CREDIT-SCORE @329 len=3 PIC 9(03)
  05 FILLER @332 len=168 PIC X(168)
# CVTRA01Y RecordLayout[TRAN-CAT-BAL-RECORD, length=50]
01 TRAN-CAT-BAL-RECORD @0 len=50
  05 TRAN-CAT-KEY @0 len=17
    10 TRANCAT-ACCT-ID @0 len=11 PIC 9(11)
    10 TRANCAT-TYPE-CD @11 len=2 PIC X(02)
    10 TRANCAT-CD @13 len=4 PIC 9(04)
  05 TRAN-CAT-BAL @17 len=11 PIC S9(09)V99
  05 FILLER @28 len=22 PIC X(22)
# CVTRA02Y RecordLayout[DIS-GROUP-RECORD, length=50]
01 DIS-GROUP-RECORD @0 len=50
  05 DIS-GROUP-KEY @0 len=16
    10 DIS-ACCT-GROUP-ID @0 len=10 PIC X(10)
    10 DIS-TRAN-TYPE-CD @10 len=2 PIC X(02)
    10 DIS-TRAN-CAT-CD @12 len=4 PIC 9(04)
  05 DIS-INT-RATE @16 len=6 PIC S9(04)V99
  05 FILLER @22 len=28 PIC X(28)
# CVTRA03Y RecordLayout[TRAN-TYPE-RECORD, length=60]
01 TRAN-TYPE-RECORD @0 len=60
  05 TRAN-TYPE @0 len=2 PIC X(02)
  05 TRAN-TYPE-DESC @2 len=50 PIC X(50)
  05 FILLER @52 len=8 PIC X(08)
# CVTRA04Y RecordLayout[TRAN-CAT-RECORD, length=60]
01 TRAN-CAT-RECORD @0 len=60
  05 TRAN-CAT-KEY @0 len=6
    10 TRAN-TYPE-CD @0 len=2 PIC X(02)
    10 TRAN-CAT-CD @2 len=4 PIC 9(04)
  05 TRAN-CAT-TYPE-DESC @6 len=50 PIC X(50)
  05 FILLER @56 len=4 PIC X(04)
# CVTRA05Y RecordLayout[TRAN-RECORD, length=350]
01 TRAN-RECORD @0 len=350
  05 TRAN-ID @0 len=16 PIC X(16)
  05 TRAN-TYPE-CD @16 len=2 PIC X(02)
  05 TRAN-CAT-CD @18 len=4 PIC 9(04)
  05 TRAN-SOURCE @22 len=10 PIC X(10)
  05 TRAN-DESC @32 len=100 PIC X(100)
  05 TRAN-AMT @132 len=11 PIC S9(09)V99
  05 TRAN-MERCHANT-ID @143 len=9 PIC 9(09)
  05 TRAN-MERCHANT-NAME @152 len=50 PIC X(50)
  05 TRAN-MERCHANT-CITY @202 len=50 PIC X(50)
  05 TRAN-MERCHANT-ZIP @252 len=10 PIC X(10)
  05 TRAN-CARD-NUM @262 len=16 PIC X(16)
  05 TRAN-ORIG-TS @278 len=26 PIC X(26)
  05 TRAN-PROC-TS @304 len=26 PIC X(26)
  05 FILLER @330 len=20 PIC X(20)
# CVTRA06Y RecordLayout[DALYTRAN-RECORD, length=350]
01 DALYTRAN-RECORD @0 len=350
  05 DALYTRAN-ID @0 len=16 PIC X(16)
  05 DALYTRAN-TYPE-CD @16 len=2 PIC X(02)
  05 DALYTRAN-CAT-CD @18 len=4 PIC 9(04)
  05 DALYTRAN-SOURCE @22 len=10 PIC X(10)
  05 DALYTRAN-DESC @32 len=100 PIC X(100)
  05 DALYTRAN-AMT @132 len=11 PIC S9(09)V99
  05 DALYTRAN-MERCHANT-ID @143 len=9 PIC 9(09)
  05 DALYTRAN-MERCHANT-NAME @152 len=50 PIC X(50)
  05 DALYTRAN-MERCHANT-CITY @202 len=50 PIC X(50)
  05 DALYTRAN-MERCHANT-ZIP @252 len=10 PIC X(10)
  05 DALYTRAN-CARD-NUM @262 len=16 PIC X(16)
  05 DALYTRAN-ORIG-TS @278 len=26 PIC X(26)
  05 DALYTRAN-PROC-TS @304 len=26 PIC X(26)
  05 FILLER @330 len=20 PIC X(20)
# CSUSR01Y RecordLayout[SEC-USER-DATA, length=80]
01 SEC-USER-DATA @0 len=80
  05 SEC-USR-ID @0 len=8 PIC X(08)
  05 SEC-USR-FNAME @8 len=20 PIC X(20)
  05 SEC-USR-LNAME @28 len=20 PIC X(20)
  05 SEC-USR-PWD @48 len=8 PIC X(08)
  05 SEC-USR-TYPE @56 len=1 PIC X(01)
  05 SEC-USR-FILLER @57 len=23 PIC X(23)
# CIPAUSMY RecordLayout[CIPAUSMY, length=100]
01 CIPAUSMY @0 len=100
  05 PA-ACCT-ID @0 len=6 PIC S9(11) PACKED_DECIMAL
  05 PA-CUST-ID @6 len=9 PIC 9(09)
  05 PA-AUTH-STATUS @15 len=1 PIC X(01)
  05 PA-ACCOUNT-STATUS @16 len=2 PIC X(02) OCCURS 5
  05 PA-CREDIT-LIMIT @26 len=6 PIC S9(09)V99 PACKED_DECIMAL
  05 PA-CASH-LIMIT @32 len=6 PIC S9(09)V99 PACKED_DECIMAL
  05 PA-CREDIT-BALANCE @38 len=6 PIC S9(09)V99 PACKED_DECIMAL
  05 PA-CASH-BALANCE @44 len=6 PIC S9(09)V99 PACKED_DECIMAL
  05 PA-APPROVED-AUTH-CNT @50 len=2 PIC S9(04) BINARY
  05 PA-DECLINED-AUTH-CNT @52 len=2 PIC S9(04) BINARY
  05 PA-APPROVED-AUTH-AMT @54 len=6 PIC S9(09)V99 PACKED_DECIMAL
  05 PA-DECLINED-AUTH-AMT @60 len=6 PIC S9(09)V99 PACKED_DECIMAL
  05 FILLER @66 len=34 PIC X(34)
# CIPAUDTY RecordLayout[CIPAUDTY, length=200]
01 CIPAUDTY @0 len=200
  05 PA-AUTHORIZATION-KEY @0 len=8
    10 PA-AUTH-DATE-9C @0 len=3 PIC S9(05) PACKED_DECIMAL
    10 PA-AUTH-TIME-9C @3 len=5 PIC S9(09) PACKED_DECIMAL
  05 PA-AUTH-ORIG-DATE @8 len=6 PIC X(06)
  05 PA-AUTH-ORIG-TIME @14 len=6 PIC X(06)
  05 PA-CARD-NUM @20 len=16 PIC X(16)
  05 PA-AUTH-TYPE @36 len=4 PIC X(04)
  05 PA-CARD-EXPIRY-DATE @40 len=4 PIC X(04)
  05 PA-MESSAGE-TYPE @44 len=6 PIC X(06)
  05 PA-MESSAGE-SOURCE @50 len=6 PIC X(06)
  05 PA-AUTH-ID-CODE @56 len=6 PIC X(06)
  05 PA-AUTH-RESP-CODE @62 len=2 PIC X(02)
  05 PA-AUTH-RESP-REASON @64 len=4 PIC X(04)
  05 PA-PROCESSING-CODE @68 len=6 PIC 9(06)
  05 PA-TRANSACTION-AMT @74 len=7 PIC S9(10)V99 PACKED_DECIMAL
  05 PA-APPROVED-AMT @81 len=7 PIC S9(10)V99 PACKED_DECIMAL
  05 PA-MERCHANT-CATAGORY-CODE @88 len=4 PIC X(04)
  05 PA-ACQR-COUNTRY-CODE @92 len=3 PIC X(03)
  05 PA-POS-ENTRY-MODE @95 len=2 PIC 9(02)
  05 PA-MERCHANT-ID @97 len=15 PIC X(15)
  05 PA-MERCHANT-NAME @112 len=22 PIC X(22)
  05 PA-MERCHANT-CITY @134 len=13 PIC X(13)
  05 PA-MERCHANT-STATE @147 len=2 PIC X(02)
  05 PA-MERCHANT-ZIP @149 len=9 PIC X(09)
  05 PA-TRANSACTION-ID @158 len=15 PIC X(15)
  05 PA-MATCH-STATUS @173 len=1 PIC X(01)
  05 PA-AUTH-FRAUD @174 len=1 PIC X(01)
  05 PA-FRAUD-RPT-DATE @175 len=8 PIC X(08)
  05 FILLER @183 len=17 PIC X(17)
