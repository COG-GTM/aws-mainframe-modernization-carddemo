# Origin of the online-services API (Spring Boot, port 8080). The client appends /api/v1.
# Leave empty to call the same origin (e.g. an ALB routing /api/* to the backend, or with MSW mocks).
VITE_API_BASE_URL=
# When "true", the Mock Service Worker implementation of aws/contracts/api.md serves every /api/v1 call.
VITE_USE_MOCKS=true
