{
  "Comment": "carddemo-daily-cycle: CardDemo business-day batch cycle (CA-7 SCHID 030 + Control-M DAILY/MONTHLY/WEEKLY folders). Input (all optional): {runId, businessDate, monthStart, saturday, authModuleInstalled, runTransactionTypeMaintenance, waitCentiseconds}. Definition substitutions: JobQueueArn, BucketName, WarningTopicArn, FailureTopicArn.",
  "QueryLanguage": "JSONata",
  "StartAt": "Init",
  "TimeoutSeconds": 43200,
  "States": {
    "Init": {
      "Type": "Pass",
      "Comment": "Derive runId/businessDate and calendar flags (month start = day 01; Saturday = ISO day 6)",
      "Assign": {
        "runId": "{% $exists($states.input.runId) ? $states.input.runId : $states.context.Execution.Name %}",
        "businessDate": "{% $exists($states.input.businessDate) ? $states.input.businessDate : $substring($now(), 0, 10) %}"
      },
      "Next": "Calendar"
    },
    "Calendar": {
      "Type": "Pass",
      "Assign": {
        "monthStart": "{% $exists($states.input.monthStart) ? $states.input.monthStart : $substring($businessDate, 8, 2) = '01' %}",
        "saturday": "{% $exists($states.input.saturday) ? $states.input.saturday : $fromMillis($toMillis($businessDate & 'T00:00:00Z'), '[F1]') = '6' %}",
        "authModuleInstalled": "{% $exists($states.input.authModuleInstalled) ? $states.input.authModuleInstalled : false %}",
        "runTransactionTypeMaintenance": "{% $exists($states.input.runTransactionTypeMaintenance) ? $states.input.runTransactionTypeMaintenance : false %}",
        "waitSeconds": "{% $exists($states.input.waitCentiseconds) ? $floor($number($states.input.waitCentiseconds) / 100) : 36 %}"
      },
      "Next": "AuthorizationModuleInstalled"
    },
    "AuthorizationModuleInstalled": {
      "Type": "Choice",
      "Comment": "CA-7 CBPAUP0J (IMS) - replatform candidate, off by default",
      "Choices": [
        {
          "Condition": "{% $authModuleInstalled = true %}",
          "Next": "PurgeExpiredAuthorizations"
        }
      ],
      "Default": "PostDailyTransactions"
    },
    "PurgeExpiredAuthorizations": {
      "Type": "Task",
      "Comment": "AWS Batch job carddemo-purge-expired-authorizations",
      "Resource": "arn:aws:states:::batch:submitJob.sync",
      "Arguments": {
        "JobName": "{% 'carddemo-purge-expired-authorizations-' & $runId %}",
        "JobDefinition": "carddemo-purge-expired-authorizations",
        "JobQueue": "${JobQueueArn}",
        "ContainerOverrides": {
          "Command": [
            "--job=purge-expired-authorizations",
            "{% '--runId=' & $runId %}",
            "{% '--businessDate=' & $businessDate %}"
          ]
        },
        "Tags": {
          "runId": "{% $runId %}",
          "businessDate": "{% $businessDate %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Batch.AWSBatchException",
            "Batch.ServerException",
            "Batch.TooManyRequestsException"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "NotifyFailure",
          "Assign": {
            "failedJob": "purge-expired-authorizations",
            "failure": "{% $states.errorOutput %}"
          }
        }
      ],
      "Next": "PurgeExpiredAuthorizationsResult"
    },
    "PurgeExpiredAuthorizationsResult": {
      "Type": "Task",
      "Comment": "Read runs/<runId>/purge-expired-authorizations.json (logical return code)",
      "Resource": "arn:aws:states:::aws-sdk:s3:getObject",
      "Arguments": {
        "Bucket": "${BucketName}",
        "Key": "{% 'runs/' & $runId & '/purge-expired-authorizations.json' %}"
      },
      "Assign": {
        "lastJob": "purge-expired-authorizations",
        "lastResult": "{% $parse($states.result.Body) %}"
      },
      "Output": "{% $states.input %}",
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "NotifyFailure",
          "Assign": {
            "failedJob": "purge-expired-authorizations",
            "failure": "{% $states.errorOutput %}"
          }
        }
      ],
      "Next": "PurgeExpiredAuthorizationsCheck"
    },
    "PurgeExpiredAuthorizationsCheck": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $lastResult.returnCode = 0 %}",
          "Next": "PostDailyTransactions"
        },
        {
          "Condition": "{% $lastResult.returnCode = 4 %}",
          "Next": "PurgeExpiredAuthorizationsWarning"
        }
      ],
      "Default": "PurgeExpiredAuthorizationsUnexpected"
    },
    "PurgeExpiredAuthorizationsUnexpected": {
      "Type": "Pass",
      "Assign": {
        "failedJob": "purge-expired-authorizations",
        "failure": "{% {'Error': 'UnexpectedReturnCode', 'Cause': $string($lastResult)} %}"
      },
      "Next": "NotifyFailure"
    },
    "PurgeExpiredAuthorizationsWarning": {
      "Type": "Task",
      "Comment": "RC 4: success with warnings -> carddemo-batch-warning, continue",
      "Resource": "arn:aws:states:::sns:publish",
      "Arguments": {
        "TopicArn": "${WarningTopicArn}",
        "Subject": "CardDemo batch warning: purge-expired-authorizations",
        "Message": "{% $string($lastResult) %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PostDailyTransactions"
        }
      ],
      "Next": "PostDailyTransactions"
    },
    "PostDailyTransactions": {
      "Type": "Task",
      "Comment": "AWS Batch job carddemo-post-daily-transactions",
      "Resource": "arn:aws:states:::batch:submitJob.sync",
      "Arguments": {
        "JobName": "{% 'carddemo-post-daily-transactions-' & $runId %}",
        "JobDefinition": "carddemo-post-daily-transactions",
        "JobQueue": "${JobQueueArn}",
        "ContainerOverrides": {
          "Command": [
            "--job=post-daily-transactions",
            "{% '--runId=' & $runId %}",
            "{% '--businessDate=' & $businessDate %}"
          ]
        },
        "Tags": {
          "runId": "{% $runId %}",
          "businessDate": "{% $businessDate %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Batch.AWSBatchException",
            "Batch.ServerException",
            "Batch.TooManyRequestsException"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "NotifyFailure",
          "Assign": {
            "failedJob": "post-daily-transactions",
            "failure": "{% $states.errorOutput %}"
          }
        }
      ],
      "Next": "PostDailyTransactionsResult"
    },
    "PostDailyTransactionsResult": {
      "Type": "Task",
      "Comment": "Read runs/<runId>/post-daily-transactions.json (logical return code)",
      "Resource": "arn:aws:states:::aws-sdk:s3:getObject",
      "Arguments": {
        "Bucket": "${BucketName}",
        "Key": "{% 'runs/' & $runId & '/post-daily-transactions.json' %}"
      },
      "Assign": {
        "lastJob": "post-daily-transactions",
        "lastResult": "{% $parse($states.result.Body) %}"
      },
      "Output": "{% $states.input %}",
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "NotifyFailure",
          "Assign": {
            "failedJob": "post-daily-transactions",
            "failure": "{% $states.errorOutput %}"
          }
        }
      ],
      "Next": "PostDailyTransactionsCheck"
    },
    "PostDailyTransactionsCheck": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $lastResult.returnCode = 0 %}",
          "Next": "WaitStep"
        },
        {
          "Condition": "{% $lastResult.returnCode = 4 %}",
          "Next": "PostDailyTransactionsWarning"
        }
      ],
      "Default": "PostDailyTransactionsUnexpected"
    },
    "PostDailyTransactionsUnexpected": {
      "Type": "Pass",
      "Assign": {
        "failedJob": "post-daily-transactions",
        "failure": "{% {'Error': 'UnexpectedReturnCode', 'Cause': $string($lastResult)} %}"
      },
      "Next": "NotifyFailure"
    },
    "PostDailyTransactionsWarning": {
      "Type": "Task",
      "Comment": "RC 4: success with warnings -> carddemo-batch-warning, continue",
      "Resource": "arn:aws:states:::sns:publish",
      "Arguments": {
        "TopicArn": "${WarningTopicArn}",
        "Subject": "CardDemo batch warning: post-daily-transactions",
        "Message": "{% $string($lastResult) %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "WaitStep"
        }
      ],
      "Next": "WaitStep"
    },
    "WaitStep": {
      "Type": "Wait",
      "Comment": "WAITSTEP.jcl (COBSWAIT PARM centiseconds)",
      "Seconds": "{% $waitSeconds %}",
      "Next": "BackupTransactions"
    },
    "BackupTransactions": {
      "Type": "Task",
