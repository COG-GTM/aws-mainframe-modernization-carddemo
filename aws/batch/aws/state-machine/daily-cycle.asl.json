      "Choices": [
        {
          "Condition": "{% $lastResult.returnCode = 0 %}",
          "Next": "IsMonthStart"
        },
        {
          "Condition": "{% $lastResult.returnCode = 4 %}",
          "Next": "BackupTransactionsWarning"
        }
      ],
      "Default": "BackupTransactionsUnexpected"
    },
    "BackupTransactionsUnexpected": {
      "Type": "Pass",
      "Assign": {
        "failedJob": "backup-transactions",
        "failure": "{% {'Error': 'UnexpectedReturnCode', 'Cause': $string($lastResult)} %}"
      },
      "Next": "NotifyFailure"
    },
    "BackupTransactionsWarning": {
      "Type": "Task",
      "Comment": "RC 4: success with warnings -> carddemo-batch-warning, continue",
      "Resource": "arn:aws:states:::sns:publish",
      "Arguments": {
        "TopicArn": "${WarningTopicArn}",
        "Subject": "CardDemo batch warning: backup-transactions",
        "Message": "{% $string($lastResult) %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "IsMonthStart"
        }
      ],
      "Next": "IsMonthStart"
    },
    "IsMonthStart": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $monthStart = true %}",
          "Next": "CalculateInterest"
        }
      ],
      "Default": "IsSaturday"
    },
