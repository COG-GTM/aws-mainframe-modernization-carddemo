      "Next": "BackupTransactionsResult"
    },
    "BackupTransactionsResult": {
      "Type": "Task",
      "Comment": "Read runs/<runId>/backup-transactions.json (logical return code)",
      "Resource": "arn:aws:states:::aws-sdk:s3:getObject",
      "Arguments": {
        "Bucket": "${BucketName}",
        "Key": "{% 'runs/' & $runId & '/backup-transactions.json' %}"
      },
      "Assign": {
        "lastJob": "backup-transactions",
        "lastResult": "{% $parse($states.result.Body) %}"
      },
