  "case_docs": {
    "clean_accept": "Card and account exist, within limit, not expired, TCATBAL row exists.",
    "card_not_in_xref": "DALYTRAN-CARD-NUM has no XREFFILE record -> reason 100 (CBTRN02C.cbl:383-387).",
    "account_not_on_file": "XREF exists but XREF-ACCT-ID has no ACCTFILE record -> reason 101 (CBTRN02C.cbl:394-399).",
    "overlimit": "CYC-CREDIT - CYC-DEBIT + AMT > CREDIT-LIMIT -> reason 102 (CBTRN02C.cbl:403-413).",
    "expired_account": "ACCT-EXPIRAION-DATE < ORIG-TS(1:10) -> reason 103 (CBTRN02C.cbl:414-420).",
    "zero_amount": "AMT = 0 posts; 0 >= 0 so it is added to CYC-CREDIT (CBTRN02C.cbl:548-552).",
    "negative_amount_credit": "AMT < 0 posts and is ADDed to CYC-DEBIT, making it negative (CBTRN02C.cbl:551).",
    "max_amount": "AMT = +999999999.99, the largest PIC S9(09)V99 (CVTRA06Y.cpy:10); limit large enough.",
    "max_negative_amount": "AMT = -999999999.99 posts; added to CYC-DEBIT and to a TCATBAL row.",
    "category_balance_crosses_zero": "TCATBAL -100.00 + AMT 250.00 -> +150.00; sign of TRAN-CAT-BAL flips (CBTRN02C.cbl:527).",
    "same_account_running_balance": "Two records on one account: 600 posts, then 500 is over the 1000 limit only because of the first (CBTRN02C.cbl:403-407, :554).",
    "same_account_two_accepts": "Two records on one account, both post; balances accumulate in ACCTFILE and TCATBALF.",
    "category_not_in_tcatbal": "No TCATBALF row for (acct,type,cat): program creates one and posts (CBTRN02C.cbl:474-479, :503-510).",
    "overlimit_and_expired": "Both 102 and 103 conditions hold; 103 is assigned last and wins (CBTRN02C.cbl:410, :417).",
    "expiry_boundary_equal": "ACCT-EXPIRAION-DATE equal to ORIG-TS(1:10): '>=' accepts (CBTRN02C.cbl:414).",
    "expiry_boundary_day_before": "ACCT-EXPIRAION-DATE one day before ORIG-TS(1:10) -> reason 103.",
    "debit_sign_interaction": "CYC-DEBIT already negative (as the program leaves it); '- CYC-DEBIT' then ADDS to the temp balance and a 50.00 purchase is over a 100.00 limit (CBTRN02C.cbl:403-405).",
    "credit_relieves_overlimit": "Account already over limit; a negative amount brings temp balance under the limit and posts.",
    "two_categories_one_account": "Same account, two (type,cat) keys: two TCATBAL rows touched, one created."
  },
