# Second GnuCOBOL runtime configuration for the "reference vs. reference"
# end-to-end exercise of the harness (used when the external candidate cannot be run).
#
# Same program, same inputs, different COB_* runtime settings:
#   * files are resolved through COB_FILE_PATH + bare <ddname> variables instead
#     of one absolute DD_<ddname> per file
#   * COB_LS_FIXED / COB_UNIX_LF / COB_PHYSICAL_CANCEL / COB_DISPLAY_WARN are set
#     explicitly (runtime defaults made visible)
# None of these affect record contents, so this run must reconcile
# byte-for-byte against the primary run.
#
# Not used: COB_SYNC=true.  With GnuCOBOL 3.1.2 + Berkeley DB it makes the
# indexed OPEN OUTPUT crash with SIGSEGV before any record is written (see
# docs/validation/golden-set/findings.md).
: "${GS_WORK:?GS_WORK must be set}"

export COB_FILE_PATH="$GS_WORK"
export DALYTRAN="DALYTRAN"
export TRANFILE="TRANSACT.idx"
export XREFFILE="XREFFILE.idx"
export DALYREJS="DALYREJS"
export ACCTFILE="ACCTFILE.idx"
export TCATBALF="TCATBALF.idx"

export COB_LS_FIXED=false
export COB_UNIX_LF=false
export COB_SET_TRACE=false
export COB_PHYSICAL_CANCEL=true
export COB_DISPLAY_WARN=false

export COB_CURRENT_DATE="${GS_FROZEN_CLOCK:?GS_FROZEN_CLOCK must be set from manifest.json frozen_clock}"
