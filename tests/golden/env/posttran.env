# GnuCOBOL runtime environment for the unmodified app/cbl/CBTRN02C.cbl.
#
# CBTRN02C uses "SELECT ... ASSIGN TO <ddname>" with a bare name
# (app/cbl/CBTRN02C.cbl:29-61).  Under -std=ibm GnuCOBOL resolves each
# bare name through the environment variable DD_<ddname> (then dd_<ddname>,
# then <ddname>, then COB_FILE_PATH).  This is the GnuCOBOL equivalent of
# the //<ddname> DD statements in app/jcl/POSTTRAN.jcl:28-42 and changes
# nothing in the program: only *where* each file lives, not how it is read.
#
# Sourced by run_reference.sh with GS_WORK pointing at a per-set scratch dir.
: "${GS_WORK:?GS_WORK must be set}"

export DD_DALYTRAN="$GS_WORK/DALYTRAN"        # SEQUENTIAL input   (CBTRN02C.cbl:29-32,  POSTTRAN.jcl:30)
export DD_TRANFILE="$GS_WORK/TRANSACT.idx"    # INDEXED output     (CBTRN02C.cbl:34-38,  POSTTRAN.jcl:28)
export DD_XREFFILE="$GS_WORK/XREFFILE.idx"    # INDEXED input      (CBTRN02C.cbl:40-44,  POSTTRAN.jcl:32)
export DD_DALYREJS="$GS_WORK/DALYREJS"        # SEQUENTIAL output  (CBTRN02C.cbl:46-49,  POSTTRAN.jcl:34-38)
export DD_ACCTFILE="$GS_WORK/ACCTFILE.idx"    # INDEXED I-O        (CBTRN02C.cbl:51-55,  POSTTRAN.jcl:39)
export DD_TCATBALF="$GS_WORK/TCATBALF.idx"    # INDEXED I-O        (CBTRN02C.cbl:57-61,  POSTTRAN.jcl:41)

# GSIDXUTL (tests/golden/cobol) loads/dumps the indexed files through ddname
# GSSEQ; run_reference.sh sets DD_GSSEQ per call.

# Deterministic clock.  CBTRN02C stamps TRAN-PROC-TS from FUNCTION CURRENT-DATE
# (app/cbl/CBTRN02C.cbl:693).  COB_CURRENT_DATE freezes that function so two
# reference runs of the same input are byte-identical.  It does not alter any
# branch: CBTRN02C never compares CURRENT-DATE against data.  The value comes
# from manifest.json "frozen_clock" (single source, written by generate.py) and
# must carry an explicit fraction (".00"); see findings.md.
export COB_CURRENT_DATE="${GS_FROZEN_CLOCK:?GS_FROZEN_CLOCK must be set from manifest.json frozen_clock}"
