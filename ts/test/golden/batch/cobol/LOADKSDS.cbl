      * Golden-harness helper: loads an indexed file (VSAM stand-in) from a
      * LINE SEQUENTIAL seed (SEQIN) or unloads it to SEQOUT.
      * Usage: loadksds <ACCT|CARD|XREF|CUST|TCAT|DISC> <L|U>
       IDENTIFICATION DIVISION.
       PROGRAM-ID. LOADKSDS.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT SEQIN-F ASSIGN TO SEQIN
               ORGANIZATION LINE SEQUENTIAL.
           SELECT SEQOUT-F ASSIGN TO SEQOUT
               ORGANIZATION LINE SEQUENTIAL.
           SELECT ACCT-F ASSIGN TO ACCTFILE ORGANIZATION INDEXED
               ACCESS SEQUENTIAL RECORD KEY ACCT-K FILE STATUS FS.
           SELECT CARD-F ASSIGN TO CARDFILE ORGANIZATION INDEXED
               ACCESS SEQUENTIAL RECORD KEY CARD-K FILE STATUS FS.
           SELECT XREF-F ASSIGN TO XREFFILE ORGANIZATION INDEXED
               ACCESS SEQUENTIAL RECORD KEY XREF-K
               ALTERNATE RECORD KEY XREF-AK FILE STATUS FS.
           SELECT CUST-F ASSIGN TO CUSTFILE ORGANIZATION INDEXED
               ACCESS SEQUENTIAL RECORD KEY CUST-K FILE STATUS FS.
           SELECT TCAT-F ASSIGN TO TCATBALF ORGANIZATION INDEXED
               ACCESS SEQUENTIAL RECORD KEY TCAT-K FILE STATUS FS.
           SELECT DISC-F ASSIGN TO DISCGRP ORGANIZATION INDEXED
               ACCESS SEQUENTIAL RECORD KEY DISC-K FILE STATUS FS.
       DATA DIVISION.
       FILE SECTION.
       FD SEQIN-F.
       01 SEQIN-REC PIC X(500).
       FD SEQOUT-F.
       01 SEQOUT-REC PIC X(500).
       FD ACCT-F.
       01 ACCT-R. 05 ACCT-K PIC X(11). 05 FILLER PIC X(289).
       FD CARD-F.
       01 CARD-R. 05 CARD-K PIC X(16). 05 FILLER PIC X(134).
       FD XREF-F.
       01 XREF-R. 05 XREF-K PIC X(16). 05 FILLER PIC X(9).
                  05 XREF-AK PIC X(11). 05 FILLER PIC X(14).
       FD CUST-F.
       01 CUST-R. 05 CUST-K PIC X(9). 05 FILLER PIC X(491).
       FD TCAT-F.
       01 TCAT-R. 05 TCAT-K PIC X(17). 05 FILLER PIC X(33).
       FD DISC-F.
       01 DISC-R. 05 DISC-K PIC X(16). 05 FILLER PIC X(34).
       WORKING-STORAGE SECTION.
       01 FS PIC XX.
       01 ARGS PIC X(20).
       01 KIND PIC X(4).
       01 MODE-X PIC X.
       01 EOF-X PIC X VALUE 'N'.
       01 BUF PIC X(500).
       PROCEDURE DIVISION.
           ACCEPT ARGS FROM COMMAND-LINE
           UNSTRING ARGS DELIMITED BY SPACE INTO KIND MODE-X
           IF MODE-X = 'L'
              OPEN INPUT SEQIN-F
              PERFORM OPEN-OUT
              PERFORM UNTIL EOF-X = 'Y'
                 READ SEQIN-F INTO BUF AT END MOVE 'Y' TO EOF-X
                   NOT AT END PERFORM PUT-REC
                 END-READ
              END-PERFORM
              CLOSE SEQIN-F
           ELSE
              OPEN OUTPUT SEQOUT-F
              PERFORM OPEN-IN
              PERFORM UNTIL EOF-X = 'Y'
                 PERFORM GET-REC
                 IF EOF-X = 'N' WRITE SEQOUT-REC FROM BUF END-IF
              END-PERFORM
              CLOSE SEQOUT-F
           END-IF
           CLOSE ACCT-F CARD-F XREF-F CUST-F TCAT-F DISC-F
           STOP RUN.
       OPEN-OUT.
           EVALUATE KIND
             WHEN 'ACCT' OPEN OUTPUT ACCT-F
             WHEN 'CARD' OPEN OUTPUT CARD-F
             WHEN 'XREF' OPEN OUTPUT XREF-F
             WHEN 'CUST' OPEN OUTPUT CUST-F
             WHEN 'TCAT' OPEN OUTPUT TCAT-F
             WHEN 'DISC' OPEN OUTPUT DISC-F
           END-EVALUATE
           IF FS NOT = '00' DISPLAY 'OPEN ' KIND ' ' FS STOP RUN END-IF.
       OPEN-IN.
           EVALUATE KIND
             WHEN 'ACCT' OPEN INPUT ACCT-F
             WHEN 'CARD' OPEN INPUT CARD-F
             WHEN 'XREF' OPEN INPUT XREF-F
             WHEN 'CUST' OPEN INPUT CUST-F
             WHEN 'TCAT' OPEN INPUT TCAT-F
             WHEN 'DISC' OPEN INPUT DISC-F
           END-EVALUATE
           IF FS NOT = '00' DISPLAY 'OPEN ' KIND ' ' FS STOP RUN END-IF.
       PUT-REC.
           EVALUATE KIND
             WHEN 'ACCT' WRITE ACCT-R FROM BUF
             WHEN 'CARD' WRITE CARD-R FROM BUF
             WHEN 'XREF' WRITE XREF-R FROM BUF
             WHEN 'CUST' WRITE CUST-R FROM BUF
             WHEN 'TCAT' WRITE TCAT-R FROM BUF
             WHEN 'DISC' WRITE DISC-R FROM BUF
           END-EVALUATE
           IF FS NOT = '00' DISPLAY 'WRITE ' KIND ' ' FS END-IF.
       GET-REC.
           MOVE SPACES TO BUF
           EVALUATE KIND
             WHEN 'ACCT' READ ACCT-F INTO BUF AT END MOVE 'Y' TO EOF-X
             WHEN 'CARD' READ CARD-F INTO BUF AT END MOVE 'Y' TO EOF-X
             WHEN 'XREF' READ XREF-F INTO BUF AT END MOVE 'Y' TO EOF-X
             WHEN 'CUST' READ CUST-F INTO BUF AT END MOVE 'Y' TO EOF-X
             WHEN 'TCAT' READ TCAT-F INTO BUF AT END MOVE 'Y' TO EOF-X
             WHEN 'DISC' READ DISC-F INTO BUF AT END MOVE 'Y' TO EOF-X
           END-EVALUATE.
