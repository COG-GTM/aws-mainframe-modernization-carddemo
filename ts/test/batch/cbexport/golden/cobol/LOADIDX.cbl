       IDENTIFICATION DIVISION.
       PROGRAM-ID. LOADIDX.
      * Loads the ASCII seed files into indexed files (VSAM stand-ins)
      * for CBEXPORT. TRANSACT comes from dailytran.txt.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT CUST-IN ASSIGN TO CUSTSEED
                  ORGANIZATION IS LINE SEQUENTIAL.
           SELECT ACCT-IN ASSIGN TO ACCTSEED
                  ORGANIZATION IS LINE SEQUENTIAL.
           SELECT XREF-IN ASSIGN TO XREFSEED
                  ORGANIZATION IS LINE SEQUENTIAL.
           SELECT TRAN-IN ASSIGN TO TRANSEED
                  ORGANIZATION IS LINE SEQUENTIAL.
           SELECT CARD-IN ASSIGN TO CARDSEED
                  ORGANIZATION IS LINE SEQUENTIAL.
           SELECT CUST-OUT ASSIGN TO CUSTFILE
                  ORGANIZATION IS INDEXED ACCESS MODE IS SEQUENTIAL
                  RECORD KEY IS CUST-KEY.
           SELECT ACCT-OUT ASSIGN TO ACCTFILE
                  ORGANIZATION IS INDEXED ACCESS MODE IS SEQUENTIAL
                  RECORD KEY IS ACCT-KEY.
           SELECT XREF-OUT ASSIGN TO XREFFILE
                  ORGANIZATION IS INDEXED ACCESS MODE IS SEQUENTIAL
                  RECORD KEY IS XREF-KEY.
           SELECT TRAN-OUT ASSIGN TO TRANSACT
                  ORGANIZATION IS INDEXED ACCESS MODE IS SEQUENTIAL
                  RECORD KEY IS TRAN-KEY.
           SELECT CARD-OUT ASSIGN TO CARDFILE
                  ORGANIZATION IS INDEXED ACCESS MODE IS SEQUENTIAL
                  RECORD KEY IS CARD-KEY.
       DATA DIVISION.
       FILE SECTION.
       FD CUST-IN.
       01 CUST-IN-REC PIC X(500).
       FD ACCT-IN.
       01 ACCT-IN-REC PIC X(300).
       FD XREF-IN.
       01 XREF-IN-REC PIC X(50).
       FD TRAN-IN.
       01 TRAN-IN-REC PIC X(350).
       FD CARD-IN.
       01 CARD-IN-REC PIC X(150).
       FD CUST-OUT.
       01 CUST-OUT-REC.
          05 CUST-KEY PIC X(9).
          05 FILLER   PIC X(491).
       FD ACCT-OUT.
       01 ACCT-OUT-REC.
          05 ACCT-KEY PIC X(11).
          05 FILLER   PIC X(289).
       FD XREF-OUT.
       01 XREF-OUT-REC.
          05 XREF-KEY PIC X(16).
          05 FILLER   PIC X(34).
       FD TRAN-OUT.
       01 TRAN-OUT-REC.
          05 TRAN-KEY PIC X(16).
          05 FILLER   PIC X(334).
       FD CARD-OUT.
       01 CARD-OUT-REC.
          05 CARD-KEY PIC X(16).
          05 FILLER   PIC X(134).
       WORKING-STORAGE SECTION.
       01 WS-EOF PIC X.
       PROCEDURE DIVISION.
           OPEN INPUT CUST-IN OUTPUT CUST-OUT
           MOVE 'N' TO WS-EOF
           PERFORM UNTIL WS-EOF = 'Y'
             READ CUST-IN AT END MOVE 'Y' TO WS-EOF
             NOT AT END WRITE CUST-OUT-REC FROM CUST-IN-REC END-READ
           END-PERFORM
           CLOSE CUST-IN CUST-OUT
           OPEN INPUT ACCT-IN OUTPUT ACCT-OUT
           MOVE 'N' TO WS-EOF
           PERFORM UNTIL WS-EOF = 'Y'
             READ ACCT-IN AT END MOVE 'Y' TO WS-EOF
             NOT AT END WRITE ACCT-OUT-REC FROM ACCT-IN-REC END-READ
           END-PERFORM
           CLOSE ACCT-IN ACCT-OUT
           OPEN INPUT XREF-IN OUTPUT XREF-OUT
           MOVE 'N' TO WS-EOF
           PERFORM UNTIL WS-EOF = 'Y'
             READ XREF-IN AT END MOVE 'Y' TO WS-EOF
             NOT AT END WRITE XREF-OUT-REC FROM XREF-IN-REC END-READ
           END-PERFORM
           CLOSE XREF-IN XREF-OUT
           OPEN INPUT TRAN-IN OUTPUT TRAN-OUT
           MOVE 'N' TO WS-EOF
           PERFORM UNTIL WS-EOF = 'Y'
             READ TRAN-IN AT END MOVE 'Y' TO WS-EOF
             NOT AT END WRITE TRAN-OUT-REC FROM TRAN-IN-REC END-READ
           END-PERFORM
           CLOSE TRAN-IN TRAN-OUT
           OPEN INPUT CARD-IN OUTPUT CARD-OUT
           MOVE 'N' TO WS-EOF
           PERFORM UNTIL WS-EOF = 'Y'
             READ CARD-IN AT END MOVE 'Y' TO WS-EOF
             NOT AT END WRITE CARD-OUT-REC FROM CARD-IN-REC END-READ
           END-PERFORM
           CLOSE CARD-IN CARD-OUT
           GOBACK.
