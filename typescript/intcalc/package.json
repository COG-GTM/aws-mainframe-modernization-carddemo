{
  "name": "@carddemo/intcalc",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript migration of the CardDemo monthly interest calculation batch job (COBOL CBACT04C / JCL INTCALC)",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "intcalc": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "start": "node --experimental-strip-types src/cli.ts"
  },
  "dependencies": {
    "decimal.js": "10.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.13.0",
    "@types/node": "22.7.5",
    "eslint": "9.13.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.11.0",
    "vitest": "2.1.3"
  }
}
