# Copy to modernization/.env (git-ignored) for docker compose. No password default is shipped.
CARDDEMO_DB_PASSWORD=change-me
# HS256 signing key of the online API tokens, at least 32 bytes (e.g. `openssl rand -base64 48`).
# Required outside the local/test profiles; local falls back to a development-only key when unset.
#CARDDEMO_JWT_SECRET=
#CARDDEMO_JWT_TTL=PT1H
# Optional overrides
#CARDDEMO_HTTP_PORT=8080
# Host port of the React UI (nginx, proxies the API)
#CARDDEMO_UI_PORT=8085
#CARDDEMO_DB_PORT=5432
# Host interface the ports are published on (0.0.0.0 exposes health details to the network)
#CARDDEMO_BIND_ADDRESS=127.0.0.1
#CARDDEMO_DB_NAME=carddemo
#CARDDEMO_DB_USER=carddemo
#CARDDEMO_PROFILES=local
#MAVEN_MIRROR_URL=https://maven-central.storage-download.googleapis.com/maven2/
