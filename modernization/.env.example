# Copy to modernization/.env (git-ignored) for docker compose. No password or key default is shipped:
# docker compose refuses to start until both values below are set.
CARDDEMO_DB_PASSWORD=change-me
# HS256 signing key of the online API tokens and the cardRef key (ADR-0017/0020), at least 32 bytes, e.g.
#   echo "CARDDEMO_JWT_SECRET=$(openssl rand -base64 48)" >> .env
# Rotating it signs everyone out and invalidates card references.
CARDDEMO_JWT_SECRET=
#CARDDEMO_JWT_TTL=PT1H
# Optional overrides
#CARDDEMO_HTTP_PORT=8080
# Host port of the React UI (nginx, proxies the API)
#CARDDEMO_UI_PORT=8085
#CARDDEMO_DB_PORT=5432
# Host interface the ports are published on (0.0.0.0 exposes health details to the network)
#CARDDEMO_BIND_ADDRESS=127.0.0.1
#CARDDEMO_DB_NAME=carddemo
#CARDDEMO_DB_USER=carddemo
#CARDDEMO_PROFILES=local
#CARDDEMO_INITIAL_LOAD=true
#CARDDEMO_INITIAL_LOAD_MODE=replace
# OpenAPI /v3/api-docs + Swagger UI (set false in production)
#CARDDEMO_API_DOCS_ENABLED=true
#MAVEN_MIRROR_URL=https://maven-central.storage-download.googleapis.com/maven2/
