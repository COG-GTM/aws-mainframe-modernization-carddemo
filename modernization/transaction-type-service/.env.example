# Copy to .env (gitignored) and set real values. Read by docker compose and the Makefile.
# Db2 instance password (db2inst1); used by the Db2 container, the service and the Db2 ITs.
DB2_PASSWORD=
# HTTP Basic users: maintainer may GET/POST/PUT/DELETE, reader may only GET. Must be different users.
TT_API_USER=
TT_API_PASSWORD=
TT_API_READER_USER=
TT_API_READER_PASSWORD=
