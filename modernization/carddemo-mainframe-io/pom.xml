  <artifactId>carddemo-mainframe-io</artifactId>
  <packaging>jar</packaging>

  <name>CardDemo Mainframe Record IO</name>
  <description>
    Sliver-independent reader/writer for the CardDemo EBCDIC datasets: code page 037 text,
    zoned and packed (COMP-3) decimal, COBOL fixed-point truncation, fixed-length record
    splitting and the declarative copybook layouts under app/cpy.
  </description>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
  </dependencies>
</project>
