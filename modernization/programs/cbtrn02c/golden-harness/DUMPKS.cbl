       IDENTIFICATION DIVISION.
       PROGRAM-ID. DUMPKS.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT OUT-FILE ASSIGN TO OUTFILE
                  ORGANIZATION IS LINE SEQUENTIAL.
           SELECT TRAN-FILE ASSIGN TO TRANFILE
                  ORGANIZATION IS INDEXED ACCESS MODE IS SEQUENTIAL
                  RECORD KEY IS R-KEY FILE STATUS IS WS-ST.
           SELECT ACCT-FILE ASSIGN TO ACCTFILE
                  ORGANIZATION IS INDEXED ACCESS MODE IS SEQUENTIAL
                  RECORD KEY IS A-KEY FILE STATUS IS WS-ST.
           SELECT TCAT-FILE ASSIGN TO TCATBALF
                  ORGANIZATION IS INDEXED ACCESS MODE IS SEQUENTIAL
                  RECORD KEY IS T-KEY FILE STATUS IS WS-ST.
       DATA DIVISION.
       FILE SECTION.
       FD OUT-FILE.
       01 OUT-REC PIC X(350).
       FD TRAN-FILE.
       01 R-REC.
          05 R-KEY PIC X(16).
          05 FILLER PIC X(334).
       FD ACCT-FILE.
       01 A-REC.
          05 A-KEY PIC 9(11).
          05 FILLER PIC X(289).
       FD TCAT-FILE.
       01 T-REC.
          05 T-KEY PIC X(17).
          05 FILLER PIC X(33).
       WORKING-STORAGE SECTION.
       01 WS-ST PIC XX.
       01 WS-EOF PIC X VALUE 'N'.
       01 WS-KIND PIC X(4).
       PROCEDURE DIVISION.
           ACCEPT WS-KIND FROM ENVIRONMENT 'KIND'
           OPEN OUTPUT OUT-FILE
           EVALUATE WS-KIND
             WHEN 'TRAN' OPEN INPUT TRAN-FILE
             WHEN 'ACCT' OPEN INPUT ACCT-FILE
             WHEN 'TCAT' OPEN INPUT TCAT-FILE
           END-EVALUATE
           PERFORM UNTIL WS-EOF = 'Y'
             EVALUATE WS-KIND
               WHEN 'TRAN' READ TRAN-FILE AT END MOVE 'Y' TO WS-EOF
                    NOT AT END MOVE R-REC TO OUT-REC WRITE OUT-REC
                    END-READ
               WHEN 'ACCT' READ ACCT-FILE AT END MOVE 'Y' TO WS-EOF
                    NOT AT END MOVE A-REC TO OUT-REC WRITE OUT-REC
                    END-READ
               WHEN 'TCAT' READ TCAT-FILE AT END MOVE 'Y' TO WS-EOF
                    NOT AT END MOVE T-REC TO OUT-REC WRITE OUT-REC
                    END-READ
             END-EVALUATE
           END-PERFORM
           CLOSE OUT-FILE TRAN-FILE ACCT-FILE TCAT-FILE
           GOBACK.
