       IDENTIFICATION DIVISION.
       PROGRAM-ID. LOADKS.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT IN-FILE ASSIGN TO INFILE
                  ORGANIZATION IS LINE SEQUENTIAL.
           SELECT XREF-FILE ASSIGN TO XREFFILE
                  ORGANIZATION IS INDEXED ACCESS MODE IS SEQUENTIAL
                  RECORD KEY IS X-KEY FILE STATUS IS WS-ST.
           SELECT ACCT-FILE ASSIGN TO ACCTFILE
                  ORGANIZATION IS INDEXED ACCESS MODE IS SEQUENTIAL
                  RECORD KEY IS A-KEY FILE STATUS IS WS-ST.
           SELECT TCAT-FILE ASSIGN TO TCATBALF
                  ORGANIZATION IS INDEXED ACCESS MODE IS SEQUENTIAL
                  RECORD KEY IS T-KEY FILE STATUS IS WS-ST.
       DATA DIVISION.
       FILE SECTION.
       FD IN-FILE.
       01 IN-REC PIC X(300).
       FD XREF-FILE.
       01 X-REC.
          05 X-KEY PIC X(16).
          05 FILLER PIC X(34).
       FD ACCT-FILE.
       01 A-REC.
          05 A-KEY PIC 9(11).
          05 FILLER PIC X(289).
       FD TCAT-FILE.
       01 T-REC.
          05 T-KEY PIC X(17).
          05 FILLER PIC X(33).
       WORKING-STORAGE SECTION.
       01 WS-ST PIC XX.
       01 WS-EOF PIC X VALUE 'N'.
       01 WS-KIND PIC X(4).
       PROCEDURE DIVISION.
           ACCEPT WS-KIND FROM ENVIRONMENT 'KIND'
           OPEN INPUT IN-FILE
           EVALUATE WS-KIND
             WHEN 'XREF' OPEN OUTPUT XREF-FILE
             WHEN 'ACCT' OPEN OUTPUT ACCT-FILE
             WHEN 'TCAT' OPEN OUTPUT TCAT-FILE
           END-EVALUATE
           PERFORM UNTIL WS-EOF = 'Y'
             MOVE SPACES TO IN-REC
             READ IN-FILE AT END MOVE 'Y' TO WS-EOF
             NOT AT END
               EVALUATE WS-KIND
                 WHEN 'XREF' MOVE IN-REC TO X-REC WRITE X-REC
                 WHEN 'ACCT' MOVE IN-REC TO A-REC WRITE A-REC
                 WHEN 'TCAT' MOVE IN-REC TO T-REC WRITE T-REC
               END-EVALUATE
               IF WS-ST NOT = '00' DISPLAY 'LOAD ERR ' WS-ST END-IF
             END-READ
           END-PERFORM
           CLOSE IN-FILE XREF-FILE ACCT-FILE TCAT-FILE
           GOBACK.
