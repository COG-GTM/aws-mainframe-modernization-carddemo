<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <!-- Every message logged inside the secured application passes through the
       scrubber, so card numbers and SSNs are masked even in lines emitted by
       the wrapped posting code. -->
  <conversionRule conversionWord="maskedMsg"
                  converterClass="com.carddemo.zerotrust.masking.MaskingMessageConverter"/>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %5p [%thread] %logger{36} - %maskedMsg%n</pattern>
    </encoder>
  </appender>
  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
